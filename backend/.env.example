# -------------------------------------------------------
# KCarrier Job Engine — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# -------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Using docker-compose defaults:
DATABASE_URL=postgresql://kcarrier:kcarrier_dev_password@localhost:5433/kcarrier_jobs

# Application environment
NODE_ENV=development

# Backend API port
API_PORT=4000

# JWT signing secret (required in production — use a strong random secret)
JWT_SECRET=your_jwt_secret_key_here

# Allowed CORS origins (comma-separated). In production, set to your frontend domain.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# How often to run job scans (minutes). Used by scheduler.
# In production, set to a higher value (e.g. 60).
JOB_SCAN_INTERVAL_MINUTES=30

# Rolling window for recent-job source discovery (days).
# Jobs whose official_posted_at >= now - N days qualify for the recent sweep.
# This recovers jobs RoleRadar missed due to temporary collector failures.
# Default: 10. Accepted range: 1–30.
# RECENT_JOB_WINDOW_DAYS=10

# HTTP request timeout for Greenhouse API calls (milliseconds).
# Default: 10000 (10 seconds). Increase if behind a slow network.
# GREENHOUSE_REQUEST_TIMEOUT_MS=10000


# Email & Notification Delivery
# In development/testing, EMAIL_MODE=console safely logs email content without network delivery.
# In production, set EMAIL_MODE=production and EMAIL_PROVIDER=smtp (or resend).
EMAIL_MODE=console
EMAIL_PROVIDER=console
EMAIL_FROM=RoleRadar Job Alerts <alerts@kcarrier.dev>
# EMAIL_REPLY_TO=support@kcarrier.dev
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
# RESEND_API_KEY=re_your_resend_api_key_here

